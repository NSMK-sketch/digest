# .env


# ===== ОБЩЕЕ =====
APP_ENV=development
LOG_LEVEL=INFO

# ===== VK (получение постов) =====
VK_TOKEN = 
VK_OWNER_ID=
VK_API_VERSION=5.199
VK_DAYS_BACK=7

# ===== VK (публикация) =====
VK_COMMUNITY_TOKEN = 
VK_GROUP_ID=-176725270

# ===== GigaChat =====
GIGA_CREDENTIALS = 
GIGA_MODEL=GigaChat-2
GIGA_BASE_URL=https://api.giga.chat/v1
GIGA_VERIFY_SSL=false

# ===== Файлы =====
PROMPT_TEMPLATE_FILE=files/prompt_template.txt
PROMPT_FILE=files/gigachat_prompt.txt
RESULT_FILE=files/gigachat_result.txt

# ===== Поведение пайплайна =====
PUBLISH_REQUIRE_CONFIRM=true